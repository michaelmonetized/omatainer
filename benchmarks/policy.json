        "sample_rate": 48000,
        "tracks": 8,
        "warmup_blocks": 128,
        "live_note_recording": false
      },
      "repetitions": 3,
      "samples": {
        "callback_wall_ns": {
          "count": 8192,
          "max": {
            "p99": 5333333,
            "max": 10666666,
            "p99_minus_p50": 2666666
          }
        },
        "render_cpu_ns": {
          "count": 8192,
          "max": {
            "p99": 3999999
          }
        }
      },
      "metrics": {
        "allocations": {
          "unit": "count",
          "min": 0,
          "max": 0
