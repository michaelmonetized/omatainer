  "test": "ui::project::performance_gate_tests::fixed_native_workloads",
  "timeout_seconds": 900,
  "scope": "Local release-profile production components driven through implemented App, callback, MIDI and IPC paths. Timing describes headless callback/render/UI work on the recorded Linux host.",
