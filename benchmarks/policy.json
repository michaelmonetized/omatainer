        "frees": {
          "unit": "count",
          "min": 0,
          "max": 0
        },
        "rejected_commands": {
          "unit": "count",
          "min": 0,
          "max": 0
        },
        "rms": {
          "unit": "linear amplitude",
          "min": 0.001,
          "max": 1
        },
        "peak": {
          "unit": "linear amplitude",
          "min": 0.001,
          "max": 1
        }
      },
      "checks": [
        "all_commands_applied",
        "finite_output",
        "nonzero_output"
